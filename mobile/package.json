{
  "name": "ai-study-companion-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start",
    "dev:android": "expo start --android --go",
    "android": "expo run:android",
    "android:emulator": "powershell -ExecutionPolicy Bypass -File ./scripts/android-emulator.ps1",
    "android:create-avd": "powershell -ExecutionPolicy Bypass -File ./scripts/create-android-avd.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@react-native-async-storage/async-storage": "latest",
    "@react-navigation/bottom-tabs": "latest",
    "@react-navigation/native": "latest",
    "@react-navigation/native-stack": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-query": "latest",
    "expo": "latest",
    "expo-auth-session": "latest",
    "expo-constants": "latest",
    "expo-document-picker": "latest",
    "expo-image-picker": "latest",
    "expo-linking": "latest",
    "expo-status-bar": "latest",
    "expo-web-browser": "latest",
    "react": "latest",
    "react-dom": "^19.2.6",
    "react-hook-form": "latest",
    "react-native": "latest",
    "react-native-safe-area-context": "latest",
    "react-native-screens": "latest",
    "react-native-web": "^0.21.2",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "eslint": "latest",
    "eslint-config-expo": "latest",
    "typescript": "latest"
  }
}
